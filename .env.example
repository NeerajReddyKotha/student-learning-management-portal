# ==============================================================================
# EduNexus Academy - Phase 1 Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL 16 Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edunexus_db
POSTGRES_USER=edunexus_user
POSTGRES_PASSWORD=edunexus_secure_password_dev123
DATABASE_URL=postgresql://edunexus_user:edunexus_secure_password_dev123@localhost:5432/edunexus_db

# ------------------------------------------------------------------------------
# Backend Service Configuration (Spring Boot 3 / Java 21)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/edunexus_db
SPRING_DATASOURCE_USERNAME=edunexus_user
SPRING_DATASOURCE_PASSWORD=edunexus_secure_password_dev123
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# Security & JWT Configuration
EDUNEXUS_JWT_SECRET="EduNexusAcademy2026SuperSecretProductionKeyWith256BitsMinimumLength!"
EDUNEXUS_JWT_EXPIRATION_MS=86400000
EDUNEXUS_JWT_ISSUER="edunexus-academy"
COOKIE_SECURE=false
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# Frontend Service Configuration (Next.js 14 / TypeScript)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="EduNexus Academy"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Cloud & AI Studio Runtime Variables
# ------------------------------------------------------------------------------
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
